generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CONSUMER
  VENDOR
  INSPECTOR
  ADMIN
}

enum AdulterantType {
  PURE
  WATER
  UREA
  STARCH
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CONSUMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tests     Test[]
}

model Device {
  id              String        @id @default(uuid())
  model           String
  calibrationData Json?
  createdAt       DateTime      @default(now())
  tests           Test[]
  calibrations    Calibration[]
}

model Calibration {
  id        String   @id @default(uuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  params    Json
  createdAt DateTime @default(now())
}

model Test {
  id                    String                 @id @default(uuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id])
  deviceId              String?
  device                Device?                @relation(fields: [deviceId], references: [id])
  sampleType            String                 @default("MILK")
  status                String                 @default("CREATED") // CREATED, CAPTURED, PROCESSING, COMPLETED, FAILED
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  prediction            Prediction?
  spectrum              Spectrum?
  location              Location?
  blockchainAttestation BlockchainAttestation?
}

model Spectrum {
  id        String   @id @default(uuid())
  testId    String   @unique
  test      Test     @relation(fields: [testId], references: [id])
  imageUrl  String
  metadata  Json?
  createdAt DateTime @default(now())
}

model Prediction {
  id              String         @id @default(uuid())
  testId          String         @unique
  test            Test           @relation(fields: [testId], references: [id])
  predictedClass  AdulterantType
  confidenceScore Float
  rawOutputs      Json?
  createdAt       DateTime       @default(now())
}

model Location {
  id        String   @id @default(uuid())
  testId    String   @unique
  test      Test     @relation(fields: [testId], references: [id])
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
}

model BlockchainAttestation {
  id        String   @id @default(uuid())
  testId    String   @unique
  test      Test     @relation(fields: [testId], references: [id])
  txHash    String
  network   String
  createdAt DateTime @default(now())
}
